{
  "name": "@pulgueta/nequi-node",
  "description": "Community-driven SDK for Nequi in Node.js",
  "version": "1.6.4",
  "license": "MIT",
  "author": {
    "name": "Andrés Rodríguez",
    "email": "arodriguez@pulgueta.com",
    "url": "https://github.com/pulgueta"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "nequi",
    "sdk",
    "nequi-sdk",
    "nequi-node",
    "bancolombia",
    "pagos",
    "pagos-bancolombia"
  ],
  "homepage": "https://github.com/pulgueta/nequi-node",
  "repository": {
    "type": "git",
    "url": "https://github.com/pulgueta/nequi-node.git"
  },
  "bugs": {
    "url": "https://github.com/pulgueta/nequi-node/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
